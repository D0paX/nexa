<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave this device.

  Nothing. NEXA writes no preferences, no database and no files: every piece
  of state it holds is in memory and dies with the process, which is the
  behaviour the secure action flow depends on — a prepared confirmation that
  survived a restart would be a confirmation nobody re-authorized.

  So there is nothing here worth restoring, and restoring it would be the
  wrong thing to do anyway. Both extraction routes are excluded explicitly
  rather than left to the default, so that the day someone adds persistence
  they have to come here and decide, instead of discovering that a security
  console's cached state has been quietly synchronising to a cloud backup.

  Applies from API 31. Older releases are covered by allowBackup="false" in
  the manifest, which this file accompanies rather than replaces.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

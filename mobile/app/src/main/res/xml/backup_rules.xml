<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-API-31 half of the same decision recorded in
  data_extraction_rules.xml: nothing NEXA holds is backed up.

  Reached only when allowBackup is enabled, which it is not. It is kept and
  filled in rather than deleted so that the two files agree — a future change
  that turns backup on for some good reason should not find one of them still
  saying "sample rules; customize as necessary".
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
